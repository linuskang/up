{
    "name": "@uplabs/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#components/*": "./src/components/*.tsx",
        "#lib/*": "./src/lib/*.ts",
        "#hooks/*": "./src/hooks/*.ts"
    },
    "exports": {
        "./globals.css": "./src/styles/globals.css",
        "./components/*": "./src/components/*.tsx",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": "./src/hooks/*.ts"
    },
    "scripts": {
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@shadcn/react": "^0.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "radix-ui": "^1.6.7",
        "react-day-picker": "^10.0.1",
        "react-resizable-panels": "^4.12.2",
        "recharts": "^3.8.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "vaul": "^1.1.2"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3"
    }
}
