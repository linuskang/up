# Database (set automatically by docker-compose, override for external DB)
DATABASE_URL=postgresql://upstream:upstream@localhost:5432/upstream

# Auth
BETTER_AUTH_SECRET=your-long-random-secret-here
BETTER_AUTH_URL=http://localhost:3000

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_EMAIL_FROM=noreply@yourdomain.com

# App version
VERSION=0.0.1
