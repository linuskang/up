@baseUrl = https://upstream.linus.my
@apiKey = up_4XyjCtQWhWoNi1U75lGaaSsc5M0E-qQN

### Create an event
POST {{baseUrl}}/api/v1/events
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "title": "Deployment finished",
  "content": "Production deploy completed",
  "category": "deploy",
  "icon": "🚀"
}

### Create an event with X-API-Key instead
POST {{baseUrl}}/api/v1/events
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "title": "Deployment finished"
}

### Complex event — payment pipeline failure
POST {{baseUrl}}/api/v1/events
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "title": "Payment processing failed",
  "icon": "💳",
  "category": "billing",
